Q.unemployed_psoe = 28;
Q.unemployed_pce = 14;
Q.unemployed_ceda = 8;
Q.unemployed_izq_rep = 6;
Q.unemployed_radical = 14;
Q.unemployed_monarchist = 4;
Q.unemployed_falange = 2;
Q.unemployed_other = 24;

Q.catholic_psoe = 4;
Q.catholic_pce = 0;
Q.catholic_ceda = 55;
Q.catholic_izq_rep = 3;
Q.catholic_radical = 11;
Q.catholic_monarchist = 18;
Q.catholic_falange = 1;
Q.catholic_other = 8;
!}
