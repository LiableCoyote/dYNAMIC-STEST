title: Election Simulation
set-jump: post_election

# Standalone calibration harness for the Spanish Republic electoral model
# (docs/planning/BC_election_engine_execution_plan.md, C-6). Not on the live
# play path -- never referenced by root.scene.dry or any other scene. Exercises
# the class->party matrix, the 1933 bloc-list law (C-3), and the CNT abstention
# mechanic (C-4) against the three historical elections: 1931 (constituent),
# 1933 (Radical-CEDA), 1936 (Popular Front). Values are directional placeholders
# for Area C-8 to calibrate against real historical results, not exact matches.

- @1931: 1931 (constituent) historical scenario
- @1933: 1933 (Radical-CEDA) historical scenario
- @1936: 1936 (Popular Front) historical scenario

@1931
on-arrival: {!
Q.industrial = 26;
Q.landless = 25;
Q.smallholder = 20;
Q.urban_middle = 14;
Q.unemployed = 10;
Q.catholic = 30;

Q.classes = ['industrial', 'landless', 'smallholder', 'urban_middle', 'unemployed', 'catholic'];
Q.parties = ['psoe', 'pce', 'ceda', 'izq_rep', 'radical', 'monarchist', 'falange', 'other'];

// The broad Republican-Socialist-Radical coalition of the constituent Cortes.
Q.psoe_in_bloc = 1;
Q.pce_in_bloc = 0;
Q.ceda_in_bloc = 0;
Q.izq_rep_in_bloc = 1;
Q.radical_in_bloc = 1;
Q.monarchist_in_bloc = 0;
Q.falange_in_bloc = 0;
Q.other_in_bloc = 0;

// CNT-FAI largely participated in 1931.
Q.anarchist_electoral_stance = 1;
Q.anarchist_strength = 30;

Q.industrial_psoe = 45;
Q.industrial_pce = 8;
Q.industrial_ceda = 5;
Q.industrial_izq_rep = 10;
Q.industrial_radical = 12;
Q.industrial_monarchist = 2;
Q.industrial_falange = 0;
Q.industrial_other = 18;

Q.landless_psoe = 40;
Q.landless_pce = 6;
Q.landless_ceda = 8;
Q.landless_izq_rep = 8;
Q.landless_radical = 14;
Q.landless_monarchist = 6;
Q.landless_falange = 0;
Q.landless_other = 18;

Q.smallholder_psoe = 10;
Q.smallholder_pce = 1;
Q.smallholder_ceda = 30;
Q.smallholder_izq_rep = 8;
Q.smallholder_radical = 20;
Q.smallholder_monarchist = 12;
Q.smallholder_falange = 0;
Q.smallholder_other = 19;

Q.urban_middle_psoe = 12;
Q.urban_middle_pce = 1;
Q.urban_middle_ceda = 12;
Q.urban_middle_izq_rep = 25;
Q.urban_middle_radical = 25;
Q.urban_middle_monarchist = 5;
Q.urban_middle_falange = 1;
Q.urban_middle_other = 19;

Q.unemployed_psoe = 35;
Q.unemployed_pce = 10;
Q.unemployed_ceda = 6;
Q.unemployed_izq_rep = 8;
Q.unemployed_radical = 12;
Q.unemployed_monarchist = 3;
Q.unemployed_falange = 1;
Q.unemployed_other = 25;

Q.catholic_psoe = 6;
Q.catholic_pce = 0;
Q.catholic_ceda = 45;
Q.catholic_izq_rep = 5;
Q.catholic_radical = 10;
Q.catholic_monarchist = 15;
Q.catholic_falange = 1;
Q.catholic_other = 18;
!}
go-to: election_algorithm
set-jump: post_election

@1933
on-arrival: {!
Q.industrial = 26;
Q.landless = 25;
Q.smallholder = 20;
Q.urban_middle = 14;
Q.unemployed = 12;
Q.catholic = 30;

Q.classes = ['industrial', 'landless', 'smallholder', 'urban_middle', 'unemployed', 'catholic'];
Q.parties = ['psoe', 'pce', 'ceda', 'izq_rep', 'radical', 'monarchist', 'falange', 'other'];

// The 1933-35 Radical-CEDA bloc: PSOE and Republican Left ran divided and alone.
Q.psoe_in_bloc = 0;
Q.pce_in_bloc = 0;
Q.ceda_in_bloc = 1;
Q.izq_rep_in_bloc = 0;
Q.radical_in_bloc = 1;
Q.monarchist_in_bloc = 1;
Q.falange_in_bloc = 0;
Q.other_in_bloc = 0;

// CNT-FAI called for abstention in 1933 -- a major factor in the left's defeat.
Q.anarchist_electoral_stance = 0;
Q.anarchist_strength = 35;

Q.industrial_psoe = 35;
Q.industrial_pce = 10;
Q.industrial_ceda = 8;
Q.industrial_izq_rep = 6;
