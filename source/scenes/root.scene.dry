@start
on-arrival: {!
Q.started = 1;
// time elapsed (in months)
Q.time = 1;
// The Second Spanish Republic is proclaimed, April 1931.
Q.year = 1931;
Q.month = 4;
Q.week = 0;
Q.week_checked = 0;
// how many actions have been taken this month?
Q.month_actions = 0;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;
// old demographics
Q.dynamic_mode = 0;

Q.old_demographics = 0;
// use decimals for reichstag seats
// TODO: not yet implemented
Q.use_decimals = 0;

// party resources
Q.resources = 2;
// party dues
Q.dues = 5;

// the state of the party
// overall dissent reduces every increase in party support.
Q.dissent = 0.05;
Q.dissent_percent = 5;

// factions
Q.factions = ['left', 'center', 'labor', 'reformist', 'neorevisionist', 'social_patriot'];
// should this be normalized to 100%?
Q.left_strength = 15;
Q.left_dissent = 20;
Q.center_strength = 30;
Q.center_dissent = 0;
Q.labor_strength = 25;
Q.labor_dissent = 5;
Q.reformist_strength = 25;
Q.reformist_dissent = 5;
Q.neorevisionist_strength = 5;
Q.neorevisionist_dissent = 10;
Q.social_patriot_strength = 0
Q.social_patriot_dissent = 0;

// secret events...
Q.unions_independent = 0;
Q.centrists_resign = 0;
Q.left_split = 0;
Q.reformists_resigned = 0;

// have we discovered neorevisionism?
Q.neorevisionism = 0;

Q.social_patriot = 0;

// crisis_urgency indicates how seriously the SPD is taking the economic crisis - scale from 0 to 10.
Q.crisis_urgency = 0;
// nazi_urgency indicates how seriously the SPD takes the nazis - scale from 0 to 10.
Q.nazi_urgency = 0;
// radicalization indicates how radical the SPD's rhetoric is - scale from 0 to 10.
Q.radicalization = 0;
// Support for the WTB plan and proto-Keynesian works creation plans in general
Q.wtb_support = 0;
// Support for Pacifism within the SPD relative to 1928
Q.pacifism = 0;
// Support for democratic reform within the SPD relative to 1928
Q.democratization = 0;
// Support for a communist coalition relative to 1928
Q.communist_coalition = 0;
// economic_plan: have we adopted *any* economic plan?
// 1 - WTB plan, 2 - AfA-bund plan, 3 - radical plan (mass nationalization of industries)
Q.economic_plan = 0;
// have we officially adopted the WTB plan?
Q.wtb_adopted = 0;
// have we formed the iron front?
Q.iron_front_formed = 0;
// people's party support
Q.peoples_party_support = 0;
Q.peoples_party = 0;
// support for nationalizations
Q.nationalization_support = 0;
Q.nationalization_adopted = 0;
// moderate economic plan
Q.moderate_plan_support = 0;
Q.moderate_plan_adopted = 0;

// organizations

// inter-party relations (PSOE's relations with the other Spanish parties)
Q.izq_rep_relation = 62;    // Republican Left (Azaña) — the PSOE's natural ally
Q.pce_relation = 25;        // PCE — communist rival to the left
Q.radical_relation = 35;    // Radical Party (Lerroux) — wary centre
Q.ceda_relation = 15;       // CEDA — the Catholic authoritarian right
// Monarchists and the Falange are invariably hostile
Q.monarchist_relation = 5;
Q.falange_relation = 0;

Q.pce_leader = "Díaz";
Q.ceda_leader = "Gil-Robles";
Q.ceda_ideology = "Right";
Q.radical_ideology = "Moderate";
Q.falange_leader = "Primo de Rivera";

// relations with the President of the Republic (Alcalá-Zamora, later Azaña)
Q.president_relation = 30;
Q.president_angry = 0;
Q.president_grr_amount = 0;

// Catalonia — the flagship autonomous region (Generalitat / ERC); full mechanics in Area F
Q.psoe_catalonia = 0;
Q.right_catalonia = 0;
Q.catalonia_leader = "Macià"

// The array of forces - paramilitary groups
// Number of members in 1928 (in thousands)
// Reichsbanner, stahlhelm, SA, rotfrontkämpferbund
// Paramilitary groups (member counts, thousands). Structure mirrors the base game;
// the full Spanish militia landscape (milicias, Guardia Civil vs Asalto) is refined in Area F.
// ugt_militia = socialist/UGT workers' militia (player); requetes = Carlist Requetés;
// falange_militia = Falange (tiny in 1931); cnt_militia = anarcho-syndicalist CNT-FAI (far-left rival).
Q.ugt_militia_strength = 1000;
Q.ugt_militia_militancy = 0.1;
Q.women_in_militia = 0;
Q.ugt_militia_banned = 0;
Q.requetes_strength = 200;
Q.requetes_militancy = 0.6;
Q.requetes_banned = 0;
Q.requetes_banned_catalonia = 0;
Q.falange_militia_strength = 10;
Q.falange_militia_militancy = 0.8;
Q.falange_militia_banned = 0;
