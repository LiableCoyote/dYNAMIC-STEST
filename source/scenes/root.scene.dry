@start
on-arrival: {!
Q.started = 1;
// time elapsed (in months)
Q.time = 1;
// The Second Spanish Republic is proclaimed, April 1931.
Q.year = 1931;
Q.month = 4;
Q.week = 0;
Q.week_checked = 0;
// how many actions have been taken this month?
Q.month_actions = 0;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;
// old demographics
Q.dynamic_mode = 0;

Q.old_demographics = 0;
// use decimals for reichstag seats
// TODO: not yet implemented
Q.use_decimals = 0;

// party resources
Q.resources = 2;
// party dues
Q.dues = 5;

// the state of the party
// overall dissent reduces every increase in party support.
Q.dissent = 0.05;
Q.dissent_percent = 5;

// factions
Q.factions = ['left', 'center', 'labor', 'reformist', 'neorevisionist', 'social_patriot'];
// should this be normalized to 100%?
Q.left_strength = 15;
Q.left_dissent = 20;
Q.center_strength = 30;
Q.center_dissent = 0;
Q.labor_strength = 25;
Q.labor_dissent = 5;
Q.reformist_strength = 25;
Q.reformist_dissent = 5;
Q.neorevisionist_strength = 5;
Q.neorevisionist_dissent = 10;
Q.social_patriot_strength = 0
Q.social_patriot_dissent = 0;

// Area G: once-per-term gate for the Labor Affairs card; reset to 0 after each
// election alongside the other _seen flags in events/election_1928.scene.dry.
Q.strike_term_seen = 0;
Q.labor_affairs_seen = 0;
Q.working_hours = 0;
Q.workers_safety = 0;
Q.works_councils = 0;
Q.government_salaries_cut = 0;
Q.industrial_levy = 0;
Q.economic_democracy = 0;
Q.cooperatives = 0;
Q.progressive_support = 0;
Q.abortion_rights = 0;
Q.womens_work = 0;
Q.family_law = 0;
Q.homosexual_rights = 0;
