Q.cnt_militia_militancy = 0.6;
Q.cnt_militia_banned = 0;
Q.cnt_militia_banned_catalonia = 0;

// Guardia Civil — the conservative rural gendarmerie (unreliable to the Republic)
Q.guardia_civil_strength = 60;
Q.guardia_civil_militancy = 2;
Q.guardia_civil_loyalty = 0.3;

// Guardia de Asalto — the Republic's loyal urban police
Q.asalto_strength = 40;
Q.asalto_militancy = 2;
Q.asalto_loyalty = 0.7;

// The Spanish Army. army_loyalty is the central input to the July-1936 coup clock.
Q.army_strength = 100;
Q.army_militancy = 5;
Q.army_loyalty = 0.25;

// The state of the country

// popular opinion
// national ideology - on a binary scale
// nationalism vs internationalism or pacifism or non-nationalism
Q.nationalism = 55;
// socialism vs capitalism
Q.socialism = 45;
// pro-republic vs anti-republic (high in the 1931 republican euphoria)
Q.pro_republic = 62;

Q.emergency_rule = 0;

// minimum percentage of votes to be represented in the Cortes
Q.electoral_threshold = 0;
// constitutional reform level
Q.constitutional_reform = 0;
// constructive vote of no confidence
Q.constructive_vonc = 0;
// reduction in presidential powers
Q.presidential_powers = 0;
// allows banning of non-constitutional parties
Q.constitutional_protection = 0;
Q.pce_banned = 0;
Q.falange_banned = 0;

// coups and capital strikes happen when you upset the right or the capitalists too much with your policies. they're an additional check on your policies, when purely electoral checks don't suffice.
// when coup_progress reaches 10 or capital_strike_progress reaches 10, there's a special event that launches the coup.
// coup_progress is the road to the July 1936 military uprising.
Q.coup_progress = 0;
Q.capital_strike_progress = 0;

Q.budget = 4;

// --- Spanish-Republic subsystem axes (declared here; mechanics designed in Area F) ---
// Anarcho-syndicalism (CNT-FAI): a large non-electoral revolutionary bloc the player
// cannot recruit but must manage. electoral_stance: 1 = participate (1931/36), 0 = abstain (1933).
Q.anarchist_strength = 30;
Q.anarchist_militancy = 0.5;
Q.anarchist_electoral_stance = 1;
Q.anarchist_insurrection = 0;
// Regional autonomy (statutes of autonomy)
Q.catalan_autonomy = 0;
Q.basque_autonomy = 0;
// Church / anticlericalism and the Catholic hierarchy as an actor
Q.clerical_conflict = 0;
Q.church_relation = 20;
// The Army of Africa / Africanista officer corps — the engine of the 1936 conspiracy
Q.africa_army = 0;

// Proportion of different social groups (weights; overlapping — the Catholic bloc
// cross-cuts the others, so these need not sum to 100). Spain 1931 was far more
// agrarian than Weimar Germany: the large rural population splits into landless
// day-laborers (braceros, dominant in the south) and smallholders (north).
// Placeholder proportions; Area C sources them precisely.
Q.industrial = 26;     // industrial / urban workers
Q.smallholder = 20;    // peasant proprietors and tenant farmers
Q.urban_middle = 14;   // salaried middle class, professionals, functionaries
Q.landless = 25;       // agricultural day-laborers (braceros)
Q.unemployed = 10;     // rural underemployment kept the effective figure high
Q.catholic = 30;       // practicing-Catholic cross-cutting bloc

// income for industrial workers (pesetas/year, placeholder; Area C/economic events refine)
Q.income = 3000;

// inflation (%, placeholder — Spain's early-1930s prices were roughly flat/mildly deflationary)
Q.inflation = 0;

// economic growth (%, placeholder — stagnant early-1930s Spanish economy; Area C refines)
Q.economic_growth = 0.5;

// economic expansion timer
Q.economic_expansion = 0;

// quality of life (as % of 1931 - currently unused - should be welfare-adjusted.)
Q.industrial_qol = 100;
Q.landless_qol = 100;
Q.unemployed_qol = 100;
Q.smallholder_qol = 100;
Q.urban_middle_qol = 100;

// Spanish Republic electoral schema (see docs/planning/B_state_schema.md).
// classes: industrial workers, landless laborers (braceros), smallholders,
// urban middle class, unemployed, and the practicing-Catholic cross-cutting bloc.
Q.classes = ['industrial', 'landless', 'smallholder', 'urban_middle', 'unemployed', 'catholic'];
// parties: PSOE (player), PCE, CEDA, Republican Left, Radicals, Monarchists,
