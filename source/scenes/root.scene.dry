Q.trans_rights = 0;
Q.interior_police_loyalty = 0.4;
Q.investigate_corruption = 0;
Q.investigate_far_right = 0;

// secret events...
Q.unions_independent = 0;
Q.centrists_resign = 0;
Q.left_split = 0;
Q.reformists_resigned = 0;

// have we discovered neorevisionism?
Q.neorevisionism = 0;

Q.social_patriot = 0;

// crisis_urgency indicates how seriously the SPD is taking the economic crisis - scale from 0 to 10.
Q.crisis_urgency = 0;
// nazi_urgency indicates how seriously the SPD takes the nazis - scale from 0 to 10.
Q.nazi_urgency = 0;
// radicalization indicates how radical the SPD's rhetoric is - scale from 0 to 10.
Q.radicalization = 0;
// Support for the WTB plan and proto-Keynesian works creation plans in general
Q.wtb_support = 0;
// Support for Pacifism within the SPD relative to 1928
Q.pacifism = 0;
// Support for democratic reform within the SPD relative to 1928
Q.democratization = 0;
// Support for a communist coalition relative to 1928
Q.communist_coalition = 0;
// economic_plan: have we adopted *any* economic plan?
// 1 - WTB plan, 2 - AfA-bund plan, 3 - radical plan (mass nationalization of industries)
Q.economic_plan = 0;
// have we officially adopted the WTB plan?
Q.wtb_adopted = 0;
// have we formed the iron front?
Q.iron_front_formed = 0;
// people's party support
Q.peoples_party_support = 0;
Q.peoples_party = 0;
// support for nationalizations
Q.nationalization_support = 0;
Q.nationalization_adopted = 0;
// moderate economic plan
Q.moderate_plan_support = 0;
Q.moderate_plan_adopted = 0;

// organizations

// inter-party relations (PSOE's relations with the other Spanish parties)
Q.izq_rep_relation = 62;    // Republican Left (Azaña) — the PSOE's natural ally
Q.pce_relation = 25;        // PCE — communist rival to the left
Q.radical_relation = 35;    // Radical Party (Lerroux) — wary centre
Q.ceda_relation = 15;       // CEDA — the Catholic authoritarian right
// Monarchists and the Falange are invariably hostile
Q.monarchist_relation = 5;
Q.falange_relation = 0;

Q.pce_leader = "Díaz";
Q.ceda_leader = "Gil-Robles";
Q.ceda_ideology = "Right";
Q.radical_ideology = "Moderate";
Q.falange_leader = "Primo de Rivera";

// relations with the President of the Republic (Alcalá-Zamora, later Azaña)
Q.president_relation = 30;
Q.president_angry = 0;
Q.president_grr_amount = 0;

// Catalonia — the flagship autonomous region (Generalitat / ERC); full mechanics in Area F
Q.psoe_catalonia = 0;
Q.right_catalonia = 0;
Q.catalonia_leader = "Macià"

// The array of forces - paramilitary groups
// Number of members in 1928 (in thousands)
// Reichsbanner, stahlhelm, SA, rotfrontkämpferbund
// Paramilitary groups (member counts, thousands). Structure mirrors the base game;
// the full Spanish militia landscape (milicias, Guardia Civil vs Asalto) is refined in Area F.
// ugt_militia = socialist/UGT workers' militia (player); requetes = Carlist Requetés;
// falange_militia = Falange (tiny in 1931); cnt_militia = anarcho-syndicalist CNT-FAI (far-left rival).
Q.ugt_militia_strength = 1000;
Q.ugt_militia_militancy = 0.1;
Q.women_in_militia = 0;
Q.ugt_militia_banned = 0;
Q.requetes_strength = 200;
Q.requetes_militancy = 0.6;
Q.requetes_banned = 0;
Q.requetes_banned_catalonia = 0;
Q.falange_militia_strength = 10;
Q.falange_militia_militancy = 0.8;
Q.falange_militia_banned = 0;
Q.falange_militia_banned_catalonia = 0;
Q.cnt_militia_strength = 300;
Q.cnt_militia_militancy = 0.6;
Q.cnt_militia_banned = 0;
Q.cnt_militia_banned_catalonia = 0;

// Guardia Civil — the conservative rural gendarmerie (unreliable to the Republic)
Q.guardia_civil_strength = 60;
Q.guardia_civil_militancy = 2;
Q.guardia_civil_loyalty = 0.3;

// Guardia de Asalto — the Republic's loyal urban police
Q.asalto_strength = 40;
Q.asalto_militancy = 2;
Q.asalto_loyalty = 0.7;
Q.asalto_training = 0; // read by party_affairs/streetfighting.scene.dry, rally.scene.dry (Area F)
Q.cnt_truce = 0; // UGT-CNT militia truce flag; read by party_affairs/streetfighting.scene.dry (Area F)

// The Spanish Army. army_loyalty is the central input to the July-1936 coup clock.
Q.army_strength = 100;
Q.army_militancy = 5;
Q.army_loyalty = 0.25;

// The state of the country

// popular opinion
// national ideology - on a binary scale
// nationalism vs internationalism or pacifism or non-nationalism
Q.nationalism = 55;
// socialism vs capitalism
Q.socialism = 45;
// pro-republic vs anti-republic (high in the 1931 republican euphoria)
Q.pro_republic = 62;

Q.emergency_rule = 0;

// minimum percentage of votes to be represented in the Cortes
Q.electoral_threshold = 0;
// constitutional reform level
Q.constitutional_reform = 0;
// constructive vote of no confidence
Q.constructive_vonc = 0;
// reduction in presidential powers
Q.presidential_powers = 0;
// allows banning of non-constitutional parties
Q.constitutional_protection = 0;
Q.pce_banned = 0;
Q.falange_banned = 0;

// coups and capital strikes happen when you upset the right or the capitalists too much with your policies. they're an additional check on your policies, when purely electoral checks don't suffice.
// when coup_progress reaches 10 or capital_strike_progress reaches 10, there's a special event that launches the coup.
// coup_progress is the road to the July 1936 military uprising.
Q.coup_progress = 0;
Q.capital_strike_progress = 0;

Q.budget = 4;

// --- Spanish-Republic subsystem axes (declared here; mechanics designed in Area F) ---
// Anarcho-syndicalism (CNT-FAI): a large non-electoral revolutionary bloc the player
// cannot recruit but must manage. electoral_stance: 1 = participate (1931/36), 0 = abstain (1933).
Q.anarchist_strength = 30;
Q.anarchist_militancy = 0.5;
Q.anarchist_electoral_stance = 1;
Q.anarchist_insurrection = 0;
// Regional autonomy (statutes of autonomy)
Q.catalan_autonomy = 0;
Q.basque_autonomy = 0;
// Church / anticlericalism and the Catholic hierarchy as an actor
Q.clerical_conflict = 0;
Q.church_relation = 20;
// The Army of Africa / Africanista officer corps — the engine of the 1936 conspiracy
Q.africa_army = 0;

// Proportion of different social groups (weights; overlapping — the Catholic bloc
// cross-cuts the others, so these need not sum to 100). Spain 1931 was far more
// agrarian than Weimar Germany: the large rural population splits into landless
// day-laborers (braceros, dominant in the south) and smallholders (north).
// Placeholder proportions; Area C sources them precisely.
Q.industrial = 26;     // industrial / urban workers
Q.smallholder = 20;    // peasant proprietors and tenant farmers
Q.urban_middle = 14;   // salaried middle class, professionals, functionaries
Q.landless = 25;       // agricultural day-laborers (braceros)
Q.unemployed = 10;     // rural underemployment kept the effective figure high
Q.catholic = 30;       // practicing-Catholic cross-cutting bloc

// income for industrial workers (pesetas/year, placeholder; Area C/economic events refine)
Q.income = 3000;

// inflation (%, placeholder — Spain's early-1930s prices were roughly flat/mildly deflationary)
Q.inflation = 0;

// economic growth (%, placeholder — stagnant early-1930s Spanish economy; Area C refines)
Q.economic_growth = 0.5;

// economic expansion timer
Q.economic_expansion = 0;

// quality of life (as % of 1931 - currently unused - should be welfare-adjusted.)
Q.industrial_qol = 100;
Q.landless_qol = 100;
Q.unemployed_qol = 100;
Q.smallholder_qol = 100;
Q.urban_middle_qol = 100;

// Spanish Republic electoral schema (see docs/planning/B_state_schema.md).
// classes: industrial workers, landless laborers (braceros), smallholders,
// urban middle class, unemployed, and the practicing-Catholic cross-cutting bloc.
Q.classes = ['industrial', 'landless', 'smallholder', 'urban_middle', 'unemployed', 'catholic'];
// parties: PSOE (player), PCE, CEDA, Republican Left, Radicals, Monarchists,
// Falange (the existential end-boss, starts ~0), and other (regionalists + minor).
Q.parties = ['psoe', 'pce', 'ceda', 'izq_rep', 'radical', 'monarchist', 'falange', 'other'];
Q.parties_graph = ['psoe', 'pce', 'ceda', 'izq_rep', 'radical', 'monarchist', 'falange', 'other'];

// Legacy splinter-formation flags (inert; the German splinter machinery is excised,
// Spanish realignments are designed in Areas C/E).
Q.sapd_formed = 0;
Q.dnf_formed = 0;
Q.dnef_formed = 0;
Q.kvp_formed = 0;
Q.lvp_formed = 0;
Q.cvp_formed = 0;

// Support for party by social group (proposed June-1931 baseline; Area C calibrates).
// Weights are relative — the electoral calculation normalizes them, so they need not sum to 100.
// CNT-abstention caveat: the 'other'/turnout share among industrial + landless is
