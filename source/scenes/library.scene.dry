            <td style="background-color: rgba(138, 3, 3, 0.2);">[+ catholic_pce_display +]%</td>
        </tr>
        <tr>
            <td><span style="color: #0087DC;">**CEDA**</span></td>
            <td style="background-color: rgba(0, 135, 220, 0.2); padding: 10px;">[+ industrial_ceda_display +]%</td>
            <td style="background-color: rgba(0, 135, 220, 0.2);">[+ urban_middle_ceda_display +]%</td>
            <td style="background-color: rgba(0, 135, 220, 0.2);">[+ smallholder_ceda_display +]%</td>
            <td style="background-color: rgba(0, 135, 220, 0.2);">[+ landless_ceda_display +]%</td>
            <td style="background-color: rgba(0, 135, 220, 0.2);">[+ unemployed_ceda_display +]%</td>
            <td style="background-color: rgba(0, 135, 220, 0.2);">[+ catholic_ceda_display +]%</td>
        </tr>
        <tr>
            <td><span style="color: #7B2D8E;">**IR**</span></td>
            <td style="background-color: rgba(123, 45, 142, 0.2); padding: 10px;">[+ industrial_izq_rep_display +]%</td>
            <td style="background-color: rgba(123, 45, 142, 0.2);">[+ urban_middle_izq_rep_display +]%</td>
            <td style="background-color: rgba(123, 45, 142, 0.2);">[+ smallholder_izq_rep_display +]%</td>
            <td style="background-color: rgba(123, 45, 142, 0.2);">[+ landless_izq_rep_display +]%</td>
            <td style="background-color: rgba(123, 45, 142, 0.2);">[+ unemployed_izq_rep_display +]%</td>
            <td style="background-color: rgba(123, 45, 142, 0.2);">[+ catholic_izq_rep_display +]%</td>
        </tr>
        <tr>
            <td><span style="color: #E8B23A;">**PRR**</span></td>
            <td style="background-color: rgba(232, 178, 58, 0.2); padding: 10px;">[+ industrial_radical_display +]%</td>
            <td style="background-color: rgba(232, 178, 58, 0.2);">[+ urban_middle_radical_display +]%</td>
            <td style="background-color: rgba(232, 178, 58, 0.2);">[+ smallholder_radical_display +]%</td>
            <td style="background-color: rgba(232, 178, 58, 0.2);">[+ landless_radical_display +]%</td>
            <td style="background-color: rgba(232, 178, 58, 0.2);">[+ unemployed_radical_display +]%</td>
            <td style="background-color: rgba(232, 178, 58, 0.2);">[+ catholic_radical_display +]%</td>
        </tr>
        <tr>
            <td><span style="color: #2E3B6E;">**Monarchist**</span></td>
            <td style="background-color: rgba(46, 59, 110, 0.2); padding: 10px;">[+ industrial_monarchist_display +]%</td>
            <td style="background-color: rgba(46, 59, 110, 0.2);">[+ urban_middle_monarchist_display +]%</td>
            <td style="background-color: rgba(46, 59, 110, 0.2);">[+ smallholder_monarchist_display +]%</td>
            <td style="background-color: rgba(46, 59, 110, 0.2);">[+ landless_monarchist_display +]%</td>
            <td style="background-color: rgba(46, 59, 110, 0.2);">[+ unemployed_monarchist_display +]%</td>
            <td style="background-color: rgba(46, 59, 110, 0.2);">[+ catholic_monarchist_display +]%</td>
        </tr>
        <tr>
            <td><span style="color: #14322a;">**Falange**</span></td>
            <td style="background-color: rgba(20, 50, 42, 0.2); padding: 10px;">[+ industrial_falange_display +]%</td>
            <td style="background-color: rgba(20, 50, 42, 0.2);">[+ urban_middle_falange_display +]%</td>
            <td style="background-color: rgba(20, 50, 42, 0.2);">[+ smallholder_falange_display +]%</td>
            <td style="background-color: rgba(20, 50, 42, 0.2);">[+ landless_falange_display +]%</td>
            <td style="background-color: rgba(20, 50, 42, 0.2);">[+ unemployed_falange_display +]%</td>
            <td style="background-color: rgba(20, 50, 42, 0.2);">[+ catholic_falange_display +]%</td>
        </tr>
        <tr>
            <td>**Others**</td>
            <td style="background-color: rgba(153, 153, 153, 0.1); padding: 10px;">[+ industrial_other_display +]%</td>
