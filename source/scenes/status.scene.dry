title: Status
new-page: true
is-special: true
on-arrival: {!
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}

// Area H Phase 1 (H-5): self-contained "who controls the streets" computation,
// same live-var idiom as the @paramilitaries panel below (Area F, F-1) - deliberately
// NOT reading post_event.scene.dry's dead prussia_force/far_right_force/etc.
// aggregate. Needed here (not just in @paramilitaries) because the "Party" section
// on this same page used to read that dead aggregate directly and always rendered
// a dangling sentence fragment as a result.
Q.left_force = Q.ugt_militia_strength * Q.ugt_militia_militancy;
Q.right_force = Q.falange_militia_strength * Q.falange_militia_militancy + Q.requetes_strength * Q.requetes_militancy;
Q.cnt_force = Q.cnt_militia_strength * Q.cnt_militia_militancy;
Q.state_force = Q.asalto_strength * Q.asalto_loyalty + Q.guardia_civil_strength * Q.guardia_civil_loyalty;
if (Q.left_force >= Q.right_force && Q.left_force >= Q.cnt_force && Q.left_force >= Q.state_force) {
    Q.streets_controlled_by = "the Republican left (UGT Militia)";
} else if (Q.right_force >= Q.cnt_force && Q.right_force >= Q.state_force) {
    Q.streets_controlled_by = "the authoritarian right (Falange/Requetés)";
} else if (Q.cnt_force >= Q.state_force) {
    Q.streets_controlled_by = "the CNT-FAI";
} else {
    Q.streets_controlled_by = "the forces of the state";
}

// --- "The Two Spains" (Area O): the two power bases, derived at display time --
// Poder Popular: the mobilized base outside the state (militias, union treasury,
// worker councils, the radicalized street). Poder Institucional: command of the
// state (ministries, a loyal army/security apparatus, the budget, legitimacy).
// A readable ~0-100 index; the crisis resolver (events/july_1936_coup, Area O
// D-4) and scripts/balance_sim.mjs mirror this formula so display and endgame
// agree. Cards move the *_bonus accumulators.
Q.movement_power = Math.round(
    (Q.ugt_militia_strength + Q.cnt_militia_strength) / 50
    + Q.dues * 2
    + (Q.works_councils || 0) * 3
    + (Q.radicalization || 0) * 2
    + (Q.nationalization_progress || 0) * 4
    + (Q.anarchist_strength || 0) * 0.2
    + (Q.movement_power_bonus || 0)
);
if (Q.movement_power < 0) Q.movement_power = 0;
Q.institutional_power = Math.round(
    (Q.psoe_in_government ? 15 : 0)
    + Q.army_loyalty * 30
    + Q.asalto_loyalty * 15
    + Q.guardia_civil_loyalty * 10
    + Q.budget
    + (Q.democratization || 0) * 2
    + (Q.welfare || 0)
    + (Q.institutional_power_bonus || 0)
);
if (Q.institutional_power < 0) Q.institutional_power = 0;
!}

