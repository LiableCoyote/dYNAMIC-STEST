@paramilitaries
on-arrival: {!
Q.ugt_militia_strength_2 = Q.ugt_militia_strength.toFixed(1);
Q.cnt_militia_strength_2 = Q.cnt_militia_strength.toFixed(1);
Q.requetes_strength_2 = Q.requetes_strength.toFixed(1);
Q.falange_militia_strength_2 = Q.falange_militia_strength.toFixed(1);

// Self-contained "Distribution of Power" computation (Area F, F-1). Deliberately does NOT
// read post_event.scene.dry's dead prussia_force/far_right_force/etc. aggregate (that block
// has been producing NaN since Area B - see docs/planning/F_new_subsystems.md) - this is an
// independent calculation over the live militia/security-force vars only.
Q.left_force = Q.ugt_militia_strength * Q.ugt_militia_militancy;
Q.right_force = Q.falange_militia_strength * Q.falange_militia_militancy + Q.requetes_strength * Q.requetes_militancy;
Q.cnt_force = Q.cnt_militia_strength * Q.cnt_militia_militancy;
Q.state_force = Q.asalto_strength * Q.asalto_loyalty + Q.guardia_civil_strength * Q.guardia_civil_loyalty;
var totalForce = Q.left_force + Q.right_force + Q.cnt_force + Q.state_force;
if (totalForce > 0) {
    Q.left_force_pct = ((Q.left_force / totalForce) * 100).toFixed(1);
    Q.right_force_pct = ((Q.right_force / totalForce) * 100).toFixed(1);
    Q.cnt_force_pct = ((Q.cnt_force / totalForce) * 100).toFixed(1);
    Q.state_force_pct = ((Q.state_force / totalForce) * 100).toFixed(1);
} else {
    Q.left_force_pct = "0.0"; Q.right_force_pct = "0.0"; Q.cnt_force_pct = "0.0"; Q.state_force_pct = "0.0";
}
if (Q.left_force >= Q.right_force && Q.left_force >= Q.cnt_force && Q.left_force >= Q.state_force) {
    Q.streets_controlled_by = "the Republican left (UGT Militia)";
} else if (Q.right_force >= Q.cnt_force && Q.right_force >= Q.state_force) {
    Q.streets_controlled_by = "the authoritarian right (Falange/Requetés)";
} else if (Q.cnt_force >= Q.state_force) {
    Q.streets_controlled_by = "the CNT-FAI";
} else {
    Q.streets_controlled_by = "the forces of the state";
}
!}

